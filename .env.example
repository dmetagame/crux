# Update these with your Supabase details from your project settings > API
# https://app.supabase.com/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=your-project-url
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# x402 / Circle Nanopayments on testnets only.
# Run `npm run generate-wallets` to auto-generate both testnet wallets.
# Legacy aliases SELLER_ADDRESS/SELLER_PRIVATE_KEY/BUYER_ADDRESS/BUYER_PRIVATE_KEY
# still work for existing deployments, but new setups should use these names.
CRUX_KEY_SCOPE=arc-testnet
CRUX_SELLER_TESTNET_ADDRESS=0xYourSellerTestnetAddress
CRUX_SELLER_TESTNET_PRIVATE_KEY=0xYourSellerTestnetPrivateKey

# House wallet used by capped public/agent demo runs.
CRUX_HOUSE_TESTNET_ADDRESS=0xYourHouseTestnetAddress
CRUX_HOUSE_TESTNET_PRIVATE_KEY=0xYourHouseTestnetPrivateKey

# Encrypts visitor-wallet private keys before storage in Supabase.
# Generate with: npm run wallets:keygen
CRUX_WALLET_ENCRYPTION_KEY=base64url-32-byte-key
# Set to true only after running `npm run wallets:encrypt` successfully.
CRUX_WALLET_REQUIRE_ENCRYPTED_WALLETS=false
# Short-lived token for protected maintenance endpoints. Rotate/remove after use.
CRUX_MAINTENANCE_TOKEN=replace-with-a-long-random-token

# Autonomous research agent — routes LLM calls through the Vercel AI Gateway.
# Develop on anthropic/claude-haiku-4.5; set MODEL=anthropic/claude-opus-4.8 for the demo.
AI_GATEWAY_API_KEY=your-vercel-ai-gateway-key

# Optional seller dashboard / withdrawal controls. Leave unset to keep the
# dashboard and Gateway admin APIs disabled in production.
ADMIN_EMAIL=admin@example.com
# Prefer ADMIN_PASSWORD_SHA256 in production; ADMIN_PASSWORD is accepted for
# local/dev convenience.
ADMIN_PASSWORD=change-me
ADMIN_PASSWORD_SHA256=
ADMIN_SESSION_SECRET=replace-with-a-long-random-token

# External-agent access controls. x402-paid endpoints do not need these keys;
# keys are only for higher-limit house-wallet runner access.
# Hash a key with: node -e "console.log(require('crypto').createHash('sha256').update(process.argv[1]).digest('hex'))" crux_agent_secret
CRUX_AGENT_KEY_HASHES=
# Optional richer config:
# CRUX_AGENT_KEY_CONFIG=[{"label":"partner","hash":"sha256hex","scopes":["agent:real","agent:run"],"hourlyLimit":20,"dailyBudgetUsdc":1,"maxBudgetUsdc":0.1}]
# Keep false in production so unauthenticated callers cannot spend the house wallet.
CRUX_PUBLIC_AGENT_RUNS_ENABLED=false
CRUX_AGENT_MODEL_ALLOWLIST=anthropic/claude-haiku-4.5
CRUX_PUBLIC_AGENT_HOURLY_LIMIT=2
CRUX_PUBLIC_AGENT_DAILY_BUDGET_USDC=0.1
CRUX_HOUSE_AGENT_DAILY_BUDGET_USDC=0.5
CRUX_HOUSE_AGENT_CONCURRENCY=1
CRUX_AGENT_HARD_MAX_BUDGET_USDC=0.1
CRUX_AGENT_KEY_HOURLY_LIMIT=20
CRUX_AGENT_KEY_DAILY_BUDGET_USDC=1
CRUX_AGENT_KEY_MAX_BUDGET_USDC=0.1
CRUX_ADMIN_AGENT_HOURLY_LIMIT=60
CRUX_ADMIN_AGENT_DAILY_BUDGET_USDC=5
CRUX_ADMIN_AGENT_MAX_BUDGET_USDC=0.1
CRUX_VISITOR_AGENT_HOURLY_LIMIT=5
CRUX_VISITOR_AGENT_DAILY_BUDGET_USDC=0.25
CRUX_VISITOR_AGENT_MAX_BUDGET_USDC=0.03
CRUX_VISITOR_AGENT_CONCURRENCY=1
CRUX_AGENT_RUN_LOCK_TTL_SECONDS=120

# Optional operational alerts for production failures.
# Supports Slack/Discord/custom JSON webhooks. Use comma/newline-separated URLs
# to send each alert to multiple destinations. If a token is set, Crux sends it
# as an Authorization: Bearer header to every destination.
CRUX_ALERT_WEBHOOK_URL=
CRUX_ALERT_WEBHOOK_TOKEN=

# Optional bearer token for manual cron/admin reconciliation calls.
# Vercel Cron uses the configured schedule headers; manual calls can use this.
CRON_SECRET=replace-with-a-long-random-token

# LangChain reference agent (OpenAI) — optional, used only by the original agent.mts demo.
OPENAI_API_KEY=your-openai-api-key
